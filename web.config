<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appSettings>
        <!-- Required settings -->
        <add key="WSGI_HANDLER" value="django.core.wsgi.get_wsgi_application()" />
        <!-- Your django path -->
        <add key="PYTHONPATH" value="C:\chat_bot" />
        <!-- Your djangoname.settings -->
        <add key="DJANGO_SETTINGS_MODULE" value="chat_bot.settings" />
    </appSettings>
    <system.webServer>
        <handlers>
            <add name="chatBot2" path="*" verb="*" modules="FastCgiModule" scriptProcessor="C:\chat_bot\chatbot_env\Scripts\python.exe|C:\chat_bot\chatbot_env\Lib\site-packages\wfastcgi.py" resourceType="Unspecified" requireAccess="Script" />
        </handlers>
    </system.webServer>
</configuration>